# Reference of all settings. Use server/.env and client/.env.local as described in README.
# Copy to server/.env. Never commit the filled file.
NODE_ENV=development
PORT=4000
# Neon pooled connection string for API, including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
# Two DIFFERENT random values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_64_CHARACTERS
CSRF_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_VALUE_AT_LEAST_64_CHARACTERS
# Exact browser origin, no trailing slash. Production must use HTTPS.
CLIENT_ORIGIN=http://localhost:3000
# Token from a Vercel PRIVATE Blob store. Never expose this to the browser.
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_PRIVATE_BLOB_READ_WRITE_TOKEN
# Number of trusted reverse proxies in front of Express; 0 for local development.
TRUST_PROXY_HOPS=0
# Only needed for the one-time admin:create command; remove ADMIN_PASSWORD afterward.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Client only:
API_PROXY_TARGET=http://127.0.0.1:4000
